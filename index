<script>
window.__MARCA__={"id": "isidora", "nombre": "Isidora", "ns": "isidora", "temaDefecto": "claro", "medsDefecto": true, "version": "2.0"};
</script>
<script>
(function(){
'use strict';

var M = window.__MARCA__;
var VERSION_DATOS = 3;
var VENTANA = 10;              // minutos de tolerancia para los avisos
var DIAS_RESPALDO = 14;

/* ================= Utilidades de fecha ================= */
function fechaISO(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function hoyISO(){return fechaISO(new Date());}
function hhmmAhora(){var d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}
function aMin(hhmm){if(!hhmm)return null;var p=hhmm.split(':');return Number(p[0])*60+Number(p[1]);}
function desdeISO(iso){var p=iso.split('-');return new Date(Number(p[0]),Number(p[1])-1,Number(p[2]));}
function idNuevo(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6);}

/* ================= Persistencia en cascada ================= */
var Store=(function(){
  var pre=M.ns+':', mem={}, hayLocal=false, hayClaude=false;
  function probarLocal(){try{localStorage.setItem(pre+'__t','1');localStorage.removeItem(pre+'__t');return true;}catch(e){return false;}}
  function init(){
    hayClaude=!!(window.storage&&typeof window.storage.get==='function');
    hayLocal=probarLocal();
  }
  function modo(){return hayLocal?'local':(hayClaude?'claude':'memoria');}
  async function leer(k){
    var s=null;
    if(hayLocal){try{s=localStorage.getItem(pre+k);}catch(e){hayLocal=false;}}
    if(s===null&&hayClaude){try{var r=await window.storage.get(pre+k);if(r&&r.value)s=r.value;}catch(e){}}
    if(s===null&&mem[k]!==undefined)s=mem[k];
    if(s===null||s===undefined)return null;
    try{return JSON.parse(s);}catch(e){return null;}
  }
  async function escribir(k,v){
    var s;try{s=JSON.stringify(v);}catch(e){return false;}
    mem[k]=s;var ok=false;
    if(hayLocal){try{localStorage.setItem(pre+k,s);ok=true;}catch(e){hayLocal=false;}}
    if(hayClaude){try{await window.storage.set(pre+k,s);ok=true;}catch(e){}}
    return ok;
  }
  return {init:init,modo:modo,leer:leer,escribir:escribir};
})();

/* ================= Estado ================= */
var D=null, guardarPend=null, diaMostrado=null, seccion='hoy';

function datosNuevos(){
  return {
    version:VERSION_DATOS,
    config:{tema:M.temaDefecto,medsOn:M.medsDefecto,
      medAM:{hora:'08:00',nombre:''},medPM:{hora:'21:00',nombre:''},
      ultimoRespaldo:null},
    rutina:[], eventos:[], dias:{}
  };
}
function migrar(d){
  if(!d||typeof d!=='object')return datosNuevos();
  var base=datosNuevos();
  d.version=d.version||1;
  d.config=Object.assign({},base.config,d.config||{});
  d.config.medAM=Object.assign({},base.config.medAM,d.config.medAM||{});
  d.config.medPM=Object.assign({},base.config.medPM,d.config.medPM||{});
  d.rutina=Array.isArray(d.rutina)?d.rutina:[];
  d.eventos=Array.isArray(d.eventos)?d.eventos:[];
  d.dias=(d.dias&&typeof d.dias==='object')?d.dias:{};
  d.rutina.forEach(function(r){if(!Array.isArray(r.omitir))r.omitir=[];r.id=String(r.id);});
  d.eventos.forEach(function(e){e.id=String(e.id);
    if(e.hecho){var dd=dia(e.fecha,d);dd.hechos['e'+e.id]=true;delete e.hecho;}});
  d.version=VERSION_DATOS;
  return d;
}
function dia(iso,cont){
  var c=cont||D;
  if(!c.dias[iso])c.dias[iso]={medAM:false,medPM:false,hechos:{},avisos:{},plan:null};
  var x=c.dias[iso];
  if(!x.hechos)x.hechos={};if(!x.avisos)x.avisos={};
  return x;
}
function persistir(){
  clearTimeout(guardarPend);
  guardarPend=setTimeout(function(){Store.escribir('datos',D);},200);
}

/* ================= Items del día ================= */
function itemsDeFecha(iso){
  var ds=desdeISO(iso).getDay(), out=[];
  D.rutina.forEach(function(r){
    if(r.dia!==ds)return;
    if((r.omitir||[]).indexOf(iso)>=0)return;
    out.push({id:'r'+r.id,hora:r.hora,texto:r.texto,tipo:'rutina',ref:r});
  });
  D.eventos.forEach(function(e){
    if(e.fecha!==iso)return;
    out.push({id:'e'+e.id,hora:e.hora||'',texto:e.texto,tipo:'evento',ref:e});
  });
  out.sort(function(a,b){
    var ha=a.hora||'99:99',hb=b.hora||'99:99';
    return ha<hb?-1:ha>hb?1:0;
  });
  return out;
}
function sincronizarPlanHoy(){
  var k=hoyISO(), d=dia(k);
  d.plan=itemsDeFecha(k).map(function(i){return {id:i.id,texto:i.texto,hora:i.hora};});
}
function estaHecho(iso,id){return !!dia(iso).hechos[id];}

/* ================= Sonido, banner y notificaciones ================= */
var audioCtx=null;
function prepararAudio(){
  if(audioCtx)return;
  try{audioCtx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){}
  if(audioCtx&&audioCtx.state==='suspended'){try{audioCtx.resume();}catch(e){}}
}
document.addEventListener('pointerdown',prepararAudio,{once:true});
document.addEventListener('keydown',prepararAudio,{once:true});

function sonar(){
  if(!audioCtx)prepararAudio();
  if(!audioCtx)return;
  try{
    var t=audioCtx.currentTime;
    [0,0.34].forEach(function(off){
      var o=audioCtx.createOscillator(),g=audioCtx.createGain();
      o.type='sine';o.frequency.value=920;
      g.gain.setValueAtTime(0.0001,t+off);
      g.gain.exponentialRampToValueAtTime(0.25,t+off+0.02);
      g.gain.exponentialRampToValueAtTime(0.0001,t+off+0.3);
      o.connect(g);g.connect(audioCtx.destination);
      o.start(t+off);o.stop(t+off+0.32);
    });
  }catch(e){}
}
var bannerTimer=null;
function mostrarBanner(t,c){
  document.getElementById('bannerT').textContent=t;
  document.getElementById('bannerC').textContent=c;
  document.getElementById('banner').classList.add('ver');
  clearTimeout(bannerTimer);
  bannerTimer=setTimeout(ocultarBanner,25000);
}
function ocultarBanner(){document.getElementById('banner').classList.remove('ver');}
document.getElementById('bannerX').addEventListener('click',ocultarBanner);

async function notificar(titulo,cuerpo,etiqueta){
  sonar();
  mostrarBanner(titulo,cuerpo);
  if(!('Notification' in window)||Notification.permission!=='granted')return;
  try{
    if('serviceWorker' in navigator&&navigator.serviceWorker.controller){
      var reg=await navigator.serviceWorker.ready;
      await reg.showNotification(titulo,{body:cuerpo,tag:etiqueta,icon:'icon-192.png',badge:'icon-192.png',renotify:false});
      return;
    }
  }catch(e){}
  try{new Notification(titulo,{body:cuerpo,tag:etiqueta,icon:'icon-192.png'});}catch(e){}
}

/* ================= Avisos con ventana de tolerancia ================= */
function objetivosDeAviso(){
  var k=hoyISO(), d=dia(k), lista=[];
  if(D.config.medsOn){
    [['AM','de la mañana'],['PM','de la noche']].forEach(function(p){
      var cual=p[0], cfg=D.config['med'+cual], min=aMin(cfg.hora);
      if(min===null||d['med'+cual])return;
      var nom=cfg.nombre?cfg.nombre+' — ':'';
      lista.push({clave:'med'+cual,min:min,titulo:'💊 Medicamento '+p[1],cuerpo:nom+'Es la hora. Márcalo en la app al tomarlo.'});
      if(min+VENTANA<1440)
        lista.push({clave:'med'+cual+'-r',min:min+VENTANA,titulo:'💊 Sigue pendiente',cuerpo:'El medicamento '+p[1]+' aún no está marcado.'});
    });
  }
  itemsDeFecha(k).forEach(function(it){
    var min=aMin(it.hora);
    if(min===null||estaHecho(k,it.id))return;
    lista.push({clave:'act-'+it.id,min:min,titulo:'Ahora · '+it.hora,cuerpo:it.texto});
  });
  return lista;
}
function chequearAvisos(){
  var k=hoyISO(), d=dia(k), ahora=aMin(hhmmAhora()), cambio=false;
  objetivosDeAviso().forEach(function(o){
    if(d.avisos[o.clave])return;
    var delta=ahora-o.min;
    if(delta>=0&&delta<=VENTANA){
      d.avisos[o.clave]=1;cambio=true;
      notificar(o.titulo,o.cuerpo,M.ns+'-'+o.clave);
    }
  });
  if(cambio)persistir();
}

/* ================= Cinta del día ================= */
function renderCinta(){
  var cont=document.getElementById('cinta'), k=hoyISO();
  var INI=6*60, FIN=24*60, ancho=FIN-INI;
  var puntos=[];
  if(D.config.medsOn){
    ['AM','PM'].forEach(function(c){
      var m=aMin(D.config['med'+c].hora);
      if(m!==null)puntos.push({min:m,cls:'med',ok:dia(k)['med'+c]});
    });
  }
  itemsDeFecha(k).forEach(function(it){
    var m=aMin(it.hora);
    if(m!==null)puntos.push({min:m,cls:it.tipo,ok:estaHecho(k,it.id)});
  });
  var html='<div class="cinta-base"></div>';
  [6,9,12,15,18,21,24].forEach(function(h){
    var pos=(h*60-INI)/ancho*100;
    if(pos<0||pos>100)return;
    html+='<div class="cinta-tick" style="left:'+pos+'%"></div>';
    html+='<div class="cinta-h" style="left:'+Math.min(97,Math.max(3,pos))+'%">'+String(h).padStart(2,'0')+'</div>';
  });
  puntos.forEach(function(p){
    var pos=(Math.min(FIN,Math.max(INI,p.min))-INI)/ancho*100;
    html+='<div class="cinta-pto '+p.cls+(p.ok?' ok':'')+'" style="left:'+pos+'%"></div>';
  });
  var ah=aMin(hhmmAhora());
  if(ah>=INI&&ah<=FIN)html+='<div class="cinta-ahora" style="left:'+((ah-INI)/ancho*100)+'%"></div>';
  if(!puntos.length)html+='<div class="cinta-vacia">Tu día, de 6 de la mañana a medianoche</div>';
  cont.innerHTML=html;
}

/* ================= Cabecera ================= */
function renderFecha(){
  var d=new Date();
  var dn=['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
  var mn=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  document.getElementById('fechaEyebrow').textContent=dn[d.getDay()]+' '+d.getDate()+' de '+mn[d.getMonth()];
  var h=d.getHours();
  var s=h<12?'Buenos días':h<20?'Buenas tardes':'Buenas noches';
  document.getElementById('saludo').innerHTML=s+', <span class="marca">'+M.nombre+'</span>';
}

/* ================= Medicamentos ================= */
function renderMeds(){
  var on=D.config.medsOn;
  document.getElementById('tarjetaMeds').style.display=on?'':'none';
  document.getElementById('cajaRacha').style.display=on?'':'none';
  if(!on)return;
  var d=dia(hoyISO());
  ['AM','PM'].forEach(function(c){
    var tomado=d['med'+c], el=document.getElementById('med'+c), cfg=D.config['med'+c];
    el.classList.toggle('tomado',tomado);
    el.setAttribute('aria-checked',String(tomado));
    document.getElementById('med'+c+'Hora').textContent=cfg.hora;
    document.getElementById('med'+c+'Estado').textContent=
      tomado?'Tomado ✓':(cfg.nombre?cfg.nombre:'Pendiente — toca para marcar');
  });
}
['AM','PM'].forEach(function(c){
  var el=document.getElementById('med'+c);
  function alternar(){
    var d=dia(hoyISO());
    d['med'+c]=!d['med'+c];
    if(d['med'+c]){delete d.avisos['med'+c];delete d.avisos['med'+c+'-r'];}
    persistir();renderMeds();renderCinta();renderHistorial();
  }
  el.addEventListener('click',alternar);
  el.addEventListener('keydown',function(e){if(e.key===' '||e.key==='Enter'){e.preventDefault();alternar();}});
});

/* ================= Timeline de hoy ================= */
function renderHoy(){
  var k=hoyISO(), d=dia(k), cont=document.getElementById('timelineHoy');
  var lista=itemsDeFecha(k), hm=hhmmAhora();
  cont.innerHTML='';
  if(!lista.length){
    cont.innerHTML='<div class="vacio">Hoy no tienes nada planificado.<br>Arma tu semana en <strong>Planificar</strong>.</div>';
    document.getElementById('progresoNum').textContent='Sin actividades hoy';
    document.getElementById('progresoBarra').style.width='0%';
    return;
  }
  var hechos=0;
  lista.forEach(function(it){
    var hecho=estaHecho(k,it.id);
    if(hecho)hechos++;
    var fila=document.createElement('div');
    fila.className='tl-item'+(hecho?' hecho':'');

    var hora=document.createElement('span');
    hora.className='tl-hora'+(it.hora&&it.hora<hm?' pasada':'');
    hora.textContent=it.hora||'—';

    var chk=document.createElement('button');
    chk.className='tl-check';
    chk.setAttribute('aria-pressed',String(hecho));
    chk.setAttribute('aria-label',(hecho?'Desmarcar ':'Marcar como hecho: ')+it.texto);
    chk.addEventListener('click',function(){
      if(estaHecho(k,it.id))delete d.hechos[it.id];
      else d.hechos[it.id]=true;
      persistir();renderHoy();renderCinta();renderHistorial();renderEventos();
    });

    var cuerpo=document.createElement('div');
    cuerpo.className='tl-cuerpo';
    var txt=document.createElement('span');txt.className='tl-texto';txt.textContent=it.texto;
    var tipo=document.createElement('span');tipo.className='tl-tipo '+it.tipo;tipo.textContent=it.tipo;
    cuerpo.appendChild(txt);cuerpo.appendChild(tipo);

    fila.appendChild(hora);fila.appendChild(chk);fila.appendChild(cuerpo);

    if(it.tipo==='rutina'){
      var om=document.createElement('button');
      om.className='tl-omitir';om.textContent='hoy no';
      om.setAttribute('aria-label','Omitir solo hoy: '+it.texto);
      om.addEventListener('click',function(){
        it.ref.omitir=it.ref.omitir||[];
        if(it.ref.omitir.indexOf(k)<0)it.ref.omitir.push(k);
        delete d.hechos[it.id];
        sincronizarPlanHoy();persistir();renderTodo();
      });
      fila.appendChild(om);
    }
    cont.appendChild(fila);
  });
  var pct=Math.round(hechos/lista.length*100);
  document.getElementById('progresoBarra').style.width=pct+'%';
  document.getElementById('progresoNum').textContent=hechos+' de '+lista.length+' · '+pct+'%';
  sincronizarPlanHoy();
}

/* ================= Planificador ================= */
var diaPlanSel=new Date().getDay();
function renderRutina(){
  document.querySelectorAll('#diasTabs button').forEach(function(b){
    b.classList.toggle('sel',Number(b.dataset.d)===diaPlanSel);
    b.classList.toggle('hoy-tab',Number(b.dataset.d)===new Date().getDay());
  });
  var cont=document.getElementById('listaRutina');
  var lista=D.rutina.filter(function(r){return r.dia===diaPlanSel;})
    .sort(function(a,b){return a.hora<b.hora?-1:1;});
  cont.innerHTML='';
  if(!lista.length){cont.innerHTML='<div class="vacio">Este día está libre. Agrega la primera actividad abajo.</div>';return;}
  lista.forEach(function(r){
    var fila=document.createElement('div');fila.className='fila';
    var h=document.createElement('span');h.className='fila-hora';h.textContent=r.hora;
    var t=document.createElement('span');t.className='fila-texto';t.textContent=r.texto;
    if((r.omitir||[]).length){
      var m=document.createElement('span');m.className='fila-marca';
      m.textContent=r.omitir.length+' omitido'+(r.omitir.length>1?'s':'');
      t.appendChild(document.createTextNode(' '));t.appendChild(m);
    }
    var x=document.createElement('button');x.className='icon-btn';x.textContent='×';
    x.setAttribute('aria-label','Eliminar '+r.texto);
    x.addEventListener('click',function(){
      D.rutina=D.rutina.filter(function(y){return y.id!==r.id;});
      sincronizarPlanHoy();persistir();renderTodo();
    });
    fila.appendChild(h);fila.appendChild(t);fila.appendChild(x);
    cont.appendChild(fila);
  });
}
document.getElementById('diasTabs').addEventListener('click',function(e){
  var b=e.target.closest('button');if(!b)return;
  diaPlanSel=Number(b.dataset.d);renderRutina();
});
function agregarRutina(){
  var hora=document.getElementById('rHora').value;
  var texto=document.getElementById('rTexto').value.trim();
  if(!hora||!texto)return;
  D.rutina.push({id:idNuevo(),dia:diaPlanSel,hora:hora,texto:texto,omitir:[]});
  document.getElementById('rTexto').value='';
  sincronizarPlanHoy();persistir();renderTodo();
}
document.getElementById('btnAgregarRutina').addEventListener('click',agregarRutina);
document.getElementById('rTexto').addEventListener('keydown',function(e){if(e.key==='Enter')agregarRutina();});

document.getElementById('btnCopiarDia').addEventListener('click',function(){
  var dest=Number(document.getElementById('selCopiar').value);
  if(dest===diaPlanSel)return;
  D.rutina.filter(function(r){return r.dia===diaPlanSel;}).forEach(function(r){
    D.rutina.push({id:idNuevo(),dia:dest,hora:r.hora,texto:r.texto,omitir:[]});
  });
  sincronizarPlanHoy();persistir();renderTodo();
  var ok=document.getElementById('okCopiar');
  ok.classList.add('ver');setTimeout(function(){ok.classList.remove('ver');},1800);
});

function renderEventos(){
  var hoy=hoyISO();
  var prox=D.eventos.filter(function(e){return e.fecha>=hoy&&!estaHecho(e.fecha,'e'+e.id);})
    .sort(function(a,b){return (a.fecha+(a.hora||'zz'))<(b.fecha+(b.hora||'zz'))?-1:1;});
  var venc=D.eventos.filter(function(e){return e.fecha<hoy&&!estaHecho(e.fecha,'e'+e.id);})
    .sort(function(a,b){return a.fecha>b.fecha?-1:1;});
  pintarEventos(document.getElementById('listaEventos'),prox,'Sin eventos próximos.');
  document.getElementById('tarjetaVencidos').style.display=venc.length?'':'none';
  if(venc.length)pintarEventos(document.getElementById('listaVencidos'),venc,'');
  renderOmitidos();
}
function fmtFecha(iso){
  if(iso===hoyISO())return 'hoy';
  var man=new Date();man.setDate(man.getDate()+1);
  if(iso===fechaISO(man))return 'mañana';
  var dn=['dom','lun','mar','mié','jue','vie','sáb'], p=iso.split('-');
  return dn[desdeISO(iso).getDay()]+' '+p[2]+'/'+p[1];
}
function pintarEventos(cont,lista,vacio){
  cont.innerHTML='';
  if(!lista.length){cont.innerHTML='<div class="vacio">'+vacio+'</div>';return;}
  lista.forEach(function(ev){
    var fila=document.createElement('div');fila.className='fila';
    var h=document.createElement('span');h.className='fila-hora violeta';
    h.textContent=fmtFecha(ev.fecha)+(ev.hora?' '+ev.hora:'');
    var t=document.createElement('span');t.className='fila-texto';t.textContent=ev.texto;
    var ok=document.createElement('button');ok.className='icon-btn';ok.textContent='✓';
    ok.setAttribute('aria-label','Marcar como hecho: '+ev.texto);
    ok.addEventListener('click',function(){
      dia(ev.fecha).hechos['e'+ev.id]=true;persistir();renderTodo();
    });
    var x=document.createElement('button');x.className='icon-btn';x.textContent='×';
    x.setAttribute('aria-label','Eliminar '+ev.texto);
    x.addEventListener('click',function(){
      D.eventos=D.eventos.filter(function(y){return y.id!==ev.id;});
      sincronizarPlanHoy();persistir();renderTodo();
    });
    fila.appendChild(h);fila.appendChild(t);fila.appendChild(ok);fila.appendChild(x);
    cont.appendChild(fila);
  });
}
function agregarEvento(){
  var f=document.getElementById('eFecha').value;
  var texto=document.getElementById('eTexto').value.trim();
  if(!f||!texto)return;
  D.eventos.push({id:idNuevo(),fecha:f,hora:document.getElementById('eHora').value||'',texto:texto});
  document.getElementById('eTexto').value='';
  sincronizarPlanHoy();persistir();renderTodo();
}
document.getElementById('btnAgregarEvento').addEventListener('click',agregarEvento);
document.getElementById('eTexto').addEventListener('keydown',function(e){if(e.key==='Enter')agregarEvento();});

function renderOmitidos(){
  var hoy=hoyISO(), filas=[];
  D.rutina.forEach(function(r){
    (r.omitir||[]).filter(function(f){return f>=hoy;}).forEach(function(f){filas.push({r:r,f:f});});
  });
  var caja=document.getElementById('tarjetaOmitidos');
  caja.style.display=filas.length?'':'none';
  if(!filas.length)return;
  var cont=document.getElementById('listaOmitidos');cont.innerHTML='';
  filas.sort(function(a,b){return a.f<b.f?-1:1;}).forEach(function(o){
    var fila=document.createElement('div');fila.className='fila';
    var h=document.createElement('span');h.className='fila-hora violeta';h.textContent=fmtFecha(o.f);
    var t=document.createElement('span');t.className='fila-texto';t.textContent=o.r.texto;
    var b=document.createElement('button');b.className='btn fantasma chico';b.textContent='Restaurar';
    b.addEventListener('click',function(){
      o.r.omitir=o.r.omitir.filter(function(x){return x!==o.f;});
      sincronizarPlanHoy();persistir();renderTodo();
    });
    fila.appendChild(h);fila.appendChild(t);fila.appendChild(b);
    cont.appendChild(fila);
  });
}

/* ================= Historial ================= */
function renderHistorial(){
  var cont=document.getElementById('listaHistorial'), hoy=new Date();
  var filas=[], suma=0, n=0;
  for(var i=0;i<14;i++){
    var f=new Date(hoy);f.setDate(hoy.getDate()-i);
    var k=fechaISO(f), reg=D.dias[k];
    var plan = reg&&Array.isArray(reg.plan) ? reg.plan : (i===0?itemsDeFecha(k):null);
    var pct=null;
    if(plan&&plan.length){
      var h=plan.filter(function(p){return reg&&reg.hechos&&reg.hechos[p.id];}).length;
      pct=Math.round(h/plan.length*100);
      if(i<7){suma+=pct;n++;}
    }else if(plan&&plan.length===0){pct=-1;}
    filas.push({k:k,reg:reg,pct:pct,esHoy:i===0});
  }
  cont.innerHTML='';
  filas.forEach(function(f){
    var fila=document.createElement('div');fila.className='hist-dia';
    var p=f.k.split('-');
    var medTxt=D.config.medsOn?((f.reg&&f.reg.medAM?'💊':'·')+(f.reg&&f.reg.medPM?'💊':'·')):'';
    var val=f.pct===null?'—':f.pct===-1?'libre':f.pct+'%';
    var w=(f.pct===null||f.pct===-1)?0:f.pct;
    fila.innerHTML='<span class="hist-fecha">'+p[2]+'/'+p[1]+(f.esHoy?' · hoy':'')+'</span>'+
      '<span class="hist-meds">'+medTxt+'</span>'+
      '<div class="hist-barra"><div style="width:'+w+'%"></div></div>'+
      '<span class="hist-pct">'+val+'</span>';
    cont.appendChild(fila);
  });
  document.getElementById('promActividades').textContent=n?Math.round(suma/n)+'%':'—';

  var racha=0;
  for(var j=0;j<400;j++){
    var g=new Date(hoy);g.setDate(hoy.getDate()-j);
    var dd=D.dias[fechaISO(g)];
    if(dd&&dd.medAM&&dd.medPM){racha++;}
    else if(j===0){continue;}
    else break;
  }
  document.getElementById('rachaMeds').textContent=racha;
}

/* ================= Exportación al calendario (.ics) ================= */
function plegar(l){
  var out=[],s=l;
  while(s.length>73){out.push(s.slice(0,73));s=' '+s.slice(73);}
  out.push(s);return out.join('\r\n');
}
function esc(s){return String(s).replace(/\\/g,'\\\\').replace(/;/g,'\\;').replace(/,/g,'\\,').replace(/\n/g,'\\n');}
function selloUTC(){return new Date().toISOString().replace(/[-:]/g,'').split('.')[0]+'Z';}
function fechaHora(iso,hhmm){return iso.replace(/-/g,'')+'T'+(hhmm||'09:00').replace(':','')+'00';}
function proximoDiaSemana(ds){
  var d=new Date(), delta=(ds-d.getDay()+7)%7;
  d.setDate(d.getDate()+delta);return fechaISO(d);
}
function generarICS(){
  var L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//'+M.nombre+'//Agenda//ES','CALSCALE:GREGORIAN','METHOD:PUBLISH'];
  var stamp=selloUTC(), BYDAY=['SU','MO','TU','WE','TH','FR','SA'];
  function alarma(trig,txt){return ['BEGIN:VALARM','ACTION:DISPLAY','TRIGGER:'+trig,'DESCRIPTION:'+esc(txt),'END:VALARM'];}

  if(D.config.medsOn){
    [['AM','Medicamento de la mañana'],['PM','Medicamento de la noche']].forEach(function(p){
      var cfg=D.config['med'+p[0]];
      if(!cfg.hora)return;
      var titulo=cfg.nombre?p[1]+' — '+cfg.nombre:p[1];
      L=L.concat(['BEGIN:VEVENT','UID:med'+p[0]+'-'+M.ns+'@agenda','DTSTAMP:'+stamp,
        'DTSTART:'+fechaHora(hoyISO(),cfg.hora),'DURATION:PT10M',
        plegar('SUMMARY:💊 '+esc(titulo)),'RRULE:FREQ=DAILY'],
        alarma('PT0M',titulo),['END:VEVENT']);
    });
  }
  D.rutina.forEach(function(r){
    var ini=proximoDiaSemana(r.dia);
    var ev=['BEGIN:VEVENT','UID:r'+r.id+'-'+M.ns+'@agenda','DTSTAMP:'+stamp,
      'DTSTART:'+fechaHora(ini,r.hora),'DURATION:PT1H',
      plegar('SUMMARY:'+esc(r.texto)),
      'RRULE:FREQ=WEEKLY;BYDAY='+BYDAY[r.dia]];
    var fut=(r.omitir||[]).filter(function(f){return f>=ini;});
    if(fut.length)ev.push(plegar('EXDATE:'+fut.map(function(f){return fechaHora(f,r.hora);}).join(',')));
    L=L.concat(ev,alarma('-PT10M',r.texto),['END:VEVENT']);
  });
  D.eventos.forEach(function(e){
    var ev=['BEGIN:VEVENT','UID:e'+e.id+'-'+M.ns+'@agenda','DTSTAMP:'+stamp,
      plegar('SUMMARY:'+esc(e.texto))];
    if(e.hora)ev=ev.concat(['DTSTART:'+fechaHora(e.fecha,e.hora),'DURATION:PT1H']);
    else ev=ev.concat(['DTSTART;VALUE=DATE:'+e.fecha.replace(/-/g,''),'DURATION:P1D']);
    L=L.concat(ev,alarma('-PT30M',e.texto),['END:VEVENT']);
  });
  L.push('END:VCALENDAR');
  return L.join('\r\n');
}
function descargar(nombre,texto,tipo){
  try{
    var b=new Blob([texto],{type:tipo}), u=URL.createObjectURL(b);
    var a=document.createElement('a');a.href=u;a.download=nombre;
    document.body.appendChild(a);a.click();document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(u);},2000);
    return true;
  }catch(e){return false;}
}
document.getElementById('btnICS').addEventListener('click',function(){
  if(!D.rutina.length&&!D.eventos.length&&!D.config.medsOn){
    mostrarBanner('Nada que exportar','Agrega actividades o activa los medicamentos primero.');return;
  }
  var ok=descargar(M.ns+'-agenda.ics',generarICS(),'text/calendar;charset=utf-8');
  mostrarBanner(ok?'Archivo listo':'No se pudo descargar',
    ok?'Ábrelo y confirma para agregarlo al calendario del teléfono.':'Prueba desde el navegador del sistema.');
});

/* ================= Respaldo ================= */
function renderRespaldo(){
  var t=D.config.ultimoRespaldo;
  document.getElementById('txtRespaldo').textContent=
    t?'Último respaldo: '+t.slice(0,10):'Todavía no has descargado ningún respaldo.';
  var viejo=!t||(Date.now()-new Date(t).getTime())>DIAS_RESPALDO*864e5;
  document.getElementById('avisoRespaldo').style.display=(viejo&&(D.rutina.length||D.eventos.length))?'flex':'none';
}
function hacerRespaldo(){
  var ok=descargar(M.ns+'-respaldo-'+hoyISO()+'.json',JSON.stringify(D,null,1),'application/json');
  if(ok){D.config.ultimoRespaldo=new Date().toISOString();persistir();renderRespaldo();
    mostrarBanner('Respaldo descargado','Guárdalo en un lugar seguro.');}
}
document.getElementById('btnDescargar').addEventListener('click',hacerRespaldo);
document.getElementById('btnRespaldoAviso').addEventListener('click',hacerRespaldo);
document.getElementById('btnRestaurar').addEventListener('click',function(){document.getElementById('fileRestaurar').click();});
document.getElementById('fileRestaurar').addEventListener('change',function(ev){
  var f=ev.target.files&&ev.target.files[0];if(!f)return;
  var fr=new FileReader();
  fr.onload=function(){
    try{
      var obj=JSON.parse(fr.result);
      if(!obj||typeof obj!=='object')throw 0;
      D=migrar(obj);sincronizarPlanHoy();persistir();cargarAjustes();renderTodo();
      mostrarBanner('Datos restaurados','Se reemplazó el contenido con el del archivo.');
    }catch(e){mostrarBanner('Archivo no válido','Ese archivo no es un respaldo de esta app.');}
    ev.target.value='';
  };
  fr.readAsText(f);
});

/* ================= Ajustes ================= */
function aplicarTema(){
  var t=D.config.tema;
  var real=t;
  if(t==='auto')real=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'oscuro':'claro';
  document.documentElement.setAttribute('data-tema',real);
  document.querySelectorAll('#segTema button').forEach(function(b){b.classList.toggle('sel',b.dataset.t===t);});
}
document.getElementById('segTema').addEventListener('click',function(e){
  var b=e.target.closest('button');if(!b)return;
  D.config.tema=b.dataset.t;persistir();aplicarTema();
});
if(window.matchMedia){
  try{window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){if(D&&D.config.tema==='auto')aplicarTema();});}catch(e){}
}
document.getElementById('swMeds').addEventListener('click',function(){
  D.config.medsOn=!D.config.medsOn;
  this.setAttribute('aria-checked',String(D.config.medsOn));
  document.getElementById('bloqueMeds').style.display=D.config.medsOn?'':'none';
  persistir();renderTodo();
});
document.getElementById('btnGuardarCfg').addEventListener('click',function(){
  D.config.medAM.hora=document.getElementById('cfgMedAMHora').value||'08:00';
  D.config.medPM.hora=document.getElementById('cfgMedPMHora').value||'21:00';
  D.config.medAM.nombre=document.getElementById('cfgMedAMNombre').value.trim();
  D.config.medPM.nombre=document.getElementById('cfgMedPMNombre').value.trim();
  persistir();renderTodo();
  var ok=document.getElementById('cfgOk');
  ok.classList.add('ver');setTimeout(function(){ok.classList.remove('ver');},1800);
});
function cargarAjustes(){
  document.getElementById('cfgMedAMHora').value=D.config.medAM.hora;
  document.getElementById('cfgMedPMHora').value=D.config.medPM.hora;
  document.getElementById('cfgMedAMNombre').value=D.config.medAM.nombre||'';
  document.getElementById('cfgMedPMNombre').value=D.config.medPM.nombre||'';
  document.getElementById('swMeds').setAttribute('aria-checked',String(D.config.medsOn));
  document.getElementById('bloqueMeds').style.display=D.config.medsOn?'':'none';
  document.getElementById('verTxt').textContent=M.version;
  aplicarTema();
}
function renderAvisosSistema(){
  document.getElementById('avisoNotif').style.display=
    ('Notification' in window&&Notification.permission==='default')?'flex':'none';
  var caja=document.getElementById('avisoAlmac');
  if(Store.modo()==='memoria'){
    caja.style.display='flex';
    document.getElementById('avisoAlmacTxt').textContent=
      'Este navegador no permite guardar datos. Lo que anotes se perderá al cerrar. Descarga un respaldo antes de salir.';
  }else caja.style.display='none';
}
document.getElementById('btnNotif').addEventListener('click',function(){
  try{Notification.requestPermission().then(renderAvisosSistema);}catch(e){}
});

/* ================= Navegación ================= */
document.querySelector('nav').addEventListener('click',function(e){
  var b=e.target.closest('button');if(!b)return;
  seccion=b.dataset.sec;
  document.querySelectorAll('nav button').forEach(function(x){x.classList.toggle('activa',x===b);});
  document.querySelectorAll('section').forEach(function(s){s.classList.remove('visible');});
  document.getElementById('sec-'+seccion).classList.add('visible');
  window.scrollTo(0,0);
});

/* ================= Render global y ciclo ================= */
function renderTodo(){
  renderFecha();renderMeds();renderHoy();renderCinta();
  renderRutina();renderEventos();renderHistorial();renderRespaldo();renderAvisosSistema();
  diaMostrado=hoyISO();
}
function latido(){
  if(hoyISO()!==diaMostrado){sincronizarPlanHoy();persistir();renderTodo();}
  else{renderCinta();renderFecha();}
  chequearAvisos();
}
document.addEventListener('visibilitychange',function(){if(!document.hidden)latido();});
window.addEventListener('focus',latido);

async function iniciar(){
  Store.init();
  var guardado=await Store.leer('datos');
  D=guardado?migrar(guardado):datosNuevos();
  document.getElementById('eFecha').value=hoyISO();
  document.getElementById('selCopiar').value=String((new Date().getDay()+1)%7);
  sincronizarPlanHoy();
  cargarAjustes();
  renderTodo();
  chequearAvisos();
  await Store.escribir('datos',D);
  setInterval(latido,30000);
}
iniciar();

if('serviceWorker' in navigator&&(location.protocol==='https:'||location.hostname==='localhost')){
  window.addEventListener('load',function(){navigator.serviceWorker.register('./sw.js').catch(function(){});});
}
})();
</script>
