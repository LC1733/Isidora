<!DOCTYPE html>
<html lang="es" data-tema="auto">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Isidora · Agenda</title>
<meta name="description" content="Agenda personal con rutina semanal, eventos, recordatorios y registro de cumplimiento. Funciona sin conexión.">
<meta name="apple-mobile-web-app-title" content="Isidora">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#D6336C">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --fondo:#FBF7F1;
  --tarjeta:#FFFFFF;
  --tarjeta2:#F4ECE1;
  --linea:#E6DACA;
  --texto:#2A2521;
  --gris:#857A6E;
  --acento:#D6336C;
  --sobre-acento:#FFFFFF;
  --acento-suave:rgba(214,51,108,.10);
  --tinta:#0F766E;
  --tinta-suave:rgba(15,118,110,.11);
  --extra:#6741D9;
  --extra-suave:rgba(103,65,217,.10);
  --alerta:#C2410C;
  color-scheme:light;
}
[data-tema="claro"]{
  --fondo:#FBF7F1;
  --tarjeta:#FFFFFF;
  --tarjeta2:#F4ECE1;
  --linea:#E6DACA;
  --texto:#2A2521;
  --gris:#857A6E;
  --acento:#D6336C;
  --sobre-acento:#FFFFFF;
  --acento-suave:rgba(214,51,108,.10);
  --tinta:#0F766E;
  --tinta-suave:rgba(15,118,110,.11);
  --extra:#6741D9;
  --extra-suave:rgba(103,65,217,.10);
  --alerta:#C2410C;
  color-scheme:light;
}
[data-tema="oscuro"]{
  --fondo:#1B1618;
  --tarjeta:#251E22;
  --tarjeta2:#2F262B;
  --linea:#3D3138;
  --texto:#F3EAE4;
  --gris:#A2928C;
  --acento:#F06595;
  --sobre-acento:#2A0E1B;
  --acento-suave:rgba(240,101,149,.14);
  --tinta:#3ECFB8;
  --tinta-suave:rgba(62,207,184,.13);
  --extra:#B197FC;
  --extra-suave:rgba(177,151,252,.14);
  --alerta:#FB923C;
  color-scheme:dark;
}


*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:var(--fondo);color:var(--texto);
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased;transition:background .2s,color .2s}
.app{max-width:720px;margin:0 auto;padding:20px 16px 96px}

/* ---------- Cabecera ---------- */
header{margin-bottom:14px}
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--acento)}
h1{font-family:'Bricolage Grotesque','Inter',sans-serif;font-weight:800;font-size:clamp(27px,6.5vw,38px);line-height:1.05;margin-top:4px;letter-spacing:-.015em}
h1 .marca{color:var(--acento)}
.sub{color:var(--gris);font-size:13.5px;margin-top:5px}

/* ---------- Cinta del día (elemento firma) ---------- */
.cinta{position:relative;height:46px;margin-top:16px;border-radius:12px;background:var(--tarjeta2);
  border:1px solid var(--linea);overflow:hidden}
.cinta-base{position:absolute;left:0;right:0;top:26px;height:1px;background:var(--linea)}
.cinta-h{position:absolute;top:29px;transform:translateX(-50%);font-family:'JetBrains Mono',monospace;
  font-size:9.5px;color:var(--gris);letter-spacing:.04em}
.cinta-tick{position:absolute;top:22px;width:1px;height:5px;background:var(--linea)}
.cinta-pto{position:absolute;top:12px;width:9px;height:9px;border-radius:50%;transform:translateX(-50%);
  border:2px solid var(--fondo)}
.cinta-pto.rutina{background:var(--tinta)}
.cinta-pto.evento{background:var(--extra)}
.cinta-pto.med{background:var(--acento)}
.cinta-pto.ok{opacity:.3}
.cinta-ahora{position:absolute;top:4px;bottom:14px;width:2px;background:var(--acento);transform:translateX(-1px);border-radius:2px}
.cinta-ahora::before{content:'';position:absolute;top:-3px;left:-3px;width:8px;height:8px;border-radius:50%;background:var(--acento)}
.cinta-vacia{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--gris);font-size:12.5px}

/* ---------- Navegación ---------- */
nav{position:fixed;bottom:0;left:0;right:0;z-index:60;background:var(--tarjeta);border-top:1px solid var(--linea);
  display:flex;justify-content:center;gap:2px;padding:6px 8px calc(6px + env(safe-area-inset-bottom))}
nav button{flex:1;max-width:160px;border:none;background:none;cursor:pointer;font-family:'Inter',sans-serif;
  font-size:12.5px;font-weight:600;color:var(--gris);padding:10px 2px;border-radius:11px;transition:background .15s,color .15s}
nav button:focus-visible{outline:2px solid var(--acento);outline-offset:2px}
nav button.activa{background:var(--acento);color:var(--sobre-acento)}

/* ---------- Bloques ---------- */
section{display:none}
section.visible{display:block}
.tarjeta{background:var(--tarjeta);border:1px solid var(--linea);border-radius:15px;padding:16px;margin-bottom:12px}
.tarjeta h2{font-family:'Bricolage Grotesque','Inter',sans-serif;font-size:17px;font-weight:600;margin-bottom:10px;
  display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.pill{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  padding:2px 9px;border-radius:20px;background:var(--acento-suave);color:var(--acento)}
.nota{font-size:12.5px;color:var(--gris);margin-top:10px;line-height:1.45}
.vacio{color:var(--gris);font-size:13.5px;padding:16px 2px;text-align:center;line-height:1.5}

/* ---------- Medicamentos ---------- */
.med-grid{display:flex;gap:10px}
.med{flex:1;background:var(--tarjeta2);border:1.5px solid var(--linea);border-radius:13px;padding:13px 10px;
  cursor:pointer;text-align:center;transition:border-color .15s,background .15s;user-select:none}
.med:focus-visible{outline:2px solid var(--acento);outline-offset:2px}
.med .icono{font-size:24px;line-height:1}
.med .lbl{font-weight:700;font-size:14.5px;margin-top:3px}
.med .cuando{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--gris);margin-top:2px}
.med .estado-med{font-size:11.5px;margin-top:6px;color:var(--gris);line-height:1.35}
.med.tomado{border-color:var(--acento);background:var(--acento-suave)}
.med.tomado .estado-med{color:var(--acento);font-weight:700}

/* ---------- Timeline ---------- */
.tl-item{display:flex;gap:11px;align-items:flex-start;padding:10px 2px;border-bottom:1px solid var(--linea)}
.tl-item:last-child{border-bottom:none}
.tl-hora{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:var(--tinta);flex:none;width:50px;padding-top:3px}
.tl-hora.pasada{color:var(--gris)}
.tl-check{flex:none;width:23px;height:23px;margin-top:2px;border-radius:8px;border:2px solid var(--gris);
  cursor:pointer;display:flex;align-items:center;justify-content:center;background:none;transition:background .15s,border-color .15s}
.tl-check:focus-visible{outline:2px solid var(--acento);outline-offset:2px}
.tl-item.hecho .tl-check{background:var(--acento);border-color:var(--acento)}
.tl-item.hecho .tl-check::after{content:'✓';color:var(--sobre-acento);font-size:13px;font-weight:800}
.tl-cuerpo{flex:1;min-width:0}
.tl-texto{word-break:break-word}
.tl-item.hecho .tl-texto{opacity:.45;text-decoration:line-through}
.tl-tipo{font-size:10px;font-weight:700;letter-spacing:.05em;padding:1px 8px;border-radius:20px;margin-left:6px;white-space:nowrap}
.tl-tipo.rutina{background:var(--tinta-suave);color:var(--tinta)}
.tl-tipo.evento{background:var(--extra-suave);color:var(--extra)}
.tl-omitir{border:none;background:none;color:var(--gris);cursor:pointer;font-size:11.5px;font-weight:600;
  padding:3px 7px;border-radius:7px;flex:none;align-self:center}
.tl-omitir:hover{color:var(--acento);background:var(--acento-suave)}
.progreso-linea{height:8px;border-radius:4px;background:var(--tarjeta2);overflow:hidden;margin-top:6px}
.progreso-linea>div{height:100%;background:var(--acento);border-radius:4px;transition:width .3s}
.progreso-num{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gris);margin-top:5px}

/* ---------- Planificador ---------- */
.dias-tabs{display:flex;gap:5px;margin-bottom:12px}
.dias-tabs button{flex:1;border:1.5px solid var(--linea);background:none;border-radius:10px;padding:9px 2px;
  font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:var(--gris);cursor:pointer;position:relative}
.dias-tabs button.sel{border-color:var(--tinta);color:var(--tinta);background:var(--tinta-suave)}
.dias-tabs button.hoy-tab::after{content:'';position:absolute;bottom:4px;left:50%;transform:translateX(-50%);
  width:4px;height:4px;border-radius:50%;background:var(--acento)}
.fila{display:flex;align-items:center;gap:10px;padding:9px 2px;border-bottom:1px solid var(--linea)}
.fila:last-child{border-bottom:none}
.fila-hora{font-family:'JetBrains Mono',monospace;font-size:13.5px;font-weight:600;color:var(--tinta);flex:none;width:52px}
.fila-hora.violeta{color:var(--extra);width:auto;min-width:64px}
.fila-texto{flex:1;min-width:0;word-break:break-word}
.fila-marca{font-size:11px;color:var(--gris);font-family:'JetBrains Mono',monospace}
.icon-btn{border:none;background:none;color:var(--gris);cursor:pointer;font-size:17px;padding:3px 8px;border-radius:7px;flex:none;line-height:1}
.icon-btn:hover{color:var(--alerta);background:var(--acento-suave)}
.icon-btn:focus-visible{outline:2px solid var(--acento);outline-offset:1px}

/* ---------- Formularios ---------- */
.form-linea{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center}
input[type=time],input[type=date],input[type=text],select{
  font-family:'Inter',sans-serif;font-size:14px;border:1.5px solid var(--linea);border-radius:10px;
  padding:10px 11px;background:var(--tarjeta2);color:var(--texto)}
input[type=time],input[type=date]{font-family:'JetBrains Mono',monospace;font-size:13px}
input[type=text]{flex:1;min-width:150px}
input:focus,select:focus{outline:2px solid var(--acento);outline-offset:1px;border-color:var(--acento)}
input::placeholder{color:var(--gris);opacity:.75}
.btn{font-family:'Inter',sans-serif;font-size:14px;font-weight:700;cursor:pointer;border-radius:11px;
  padding:11px 18px;border:none;background:var(--acento);color:var(--sobre-acento);transition:transform .1s}
.btn:active{transform:scale(.97)}
.btn:focus-visible{outline:2px solid var(--texto);outline-offset:2px}
.btn.chico{padding:9px 14px;font-size:13px}
.btn.fantasma{background:none;border:1.5px solid var(--linea);color:var(--texto)}
.btn.fantasma:hover{border-color:var(--acento)}
.btn-fila{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}

/* ---------- Ajustes ---------- */
.cfg-fila{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:11px}
.cfg-fila label{font-weight:600;font-size:14px;flex:none;width:118px}
.seg{display:flex;gap:4px;background:var(--tarjeta2);padding:4px;border-radius:11px;border:1px solid var(--linea)}
.seg button{border:none;background:none;cursor:pointer;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;
  color:var(--gris);padding:7px 13px;border-radius:8px}
.seg button.sel{background:var(--acento);color:var(--sobre-acento)}
.interruptor{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 0}
.sw{position:relative;width:46px;height:27px;flex:none;border-radius:20px;background:var(--linea);border:none;cursor:pointer;transition:background .18s}
.sw::after{content:'';position:absolute;top:3px;left:3px;width:21px;height:21px;border-radius:50%;background:#fff;transition:transform .18s}
.sw[aria-checked="true"]{background:var(--acento)}
.sw[aria-checked="true"]::after{transform:translateX(19px)}
.sw:focus-visible{outline:2px solid var(--acento);outline-offset:2px}
.aviso{display:flex;align-items:center;gap:10px;background:var(--acento-suave);border:1px solid var(--acento);
  border-radius:11px;padding:11px 13px;margin-bottom:12px;font-size:13px;line-height:1.4}
.aviso.gris{background:var(--tarjeta2);border-color:var(--linea)}
.ok-msg{color:var(--acento);font-size:13px;font-weight:700;margin-left:10px;opacity:0;transition:opacity .3s}
.ok-msg.ver{opacity:1}

/* ---------- Historial ---------- */
.racha-caja{display:flex;gap:10px;margin-bottom:12px}
.racha-caja .tarjeta{flex:1;text-align:center;margin-bottom:0;padding:14px 8px}
.racha-num{font-family:'Bricolage Grotesque','Inter',sans-serif;font-size:31px;font-weight:800;color:var(--acento);line-height:1}
.racha-lbl{font-size:10.5px;color:var(--gris);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-top:5px}
.hist-dia{display:flex;align-items:center;gap:9px;padding:8px 2px;border-bottom:1px solid var(--linea)}
.hist-dia:last-child{border-bottom:none}
.hist-fecha{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gris);flex:none;width:92px}
.hist-meds{flex:none;width:44px;font-size:13px;letter-spacing:2px;text-align:center}
.hist-barra{flex:1;height:9px;border-radius:5px;background:var(--tarjeta2);overflow:hidden}
.hist-barra>div{height:100%;border-radius:5px;background:var(--tinta)}
.hist-pct{font-family:'JetBrains Mono',monospace;font-size:12px;flex:none;width:42px;text-align:right;font-weight:600}

/* ---------- Banner de aviso en pantalla ---------- */
.banner{position:fixed;left:12px;right:12px;top:calc(12px + env(safe-area-inset-top));z-index:100;
  background:var(--acento);color:var(--sobre-acento);border-radius:13px;padding:13px 15px;
  box-shadow:0 10px 30px rgba(0,0,0,.28);display:none;align-items:flex-start;gap:11px;max-width:696px;margin:0 auto}
.banner.ver{display:flex}
.banner-t{font-weight:800;font-size:14.5px}
.banner-c{font-size:13.5px;margin-top:2px;line-height:1.35}
.banner button{border:none;background:none;color:var(--sobre-acento);font-size:19px;cursor:pointer;
  padding:0 2px;line-height:1;flex:none;opacity:.75}

@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media (max-width:430px){
  .app{padding:16px 12px 96px}
  .dias-tabs button{font-size:12px;padding:8px 1px}
  .cfg-fila label{width:100%}
  .hist-fecha{width:78px;font-size:11.5px}
}
</style>
</head>
<body>

<div class="banner" id="banner" role="status" aria-live="polite">
  <div style="flex:1"><div class="banner-t" id="bannerT"></div><div class="banner-c" id="bannerC"></div></div>
  <button id="bannerX" aria-label="Cerrar aviso">×</button>
</div>

<div class="app">

  <header>
    <div class="eyebrow" id="fechaEyebrow">—</div>
    <h1 id="saludo">Hola</h1>
    <div class="sub">Escribe la semana una vez y deja la cabeza libre para lo demás.</div>
    <div class="cinta" id="cinta"></div>
  </header>

  <!-- ============ HOY ============ -->
  <section id="sec-hoy" class="visible">
    <div class="tarjeta" id="tarjetaMeds">
      <h2>Medicamentos <span class="pill">lo primero</span></h2>
      <div class="med-grid">
        <div class="med" id="medAM" role="checkbox" aria-checked="false" tabindex="0">
          <div class="icono">🌅</div><div class="lbl">Mañana</div>
          <div class="cuando" id="medAMHora">08:00</div>
          <div class="estado-med" id="medAMEstado">Pendiente</div>
        </div>
        <div class="med" id="medPM" role="checkbox" aria-checked="false" tabindex="0">
          <div class="icono">🌙</div><div class="lbl">Noche</div>
          <div class="cuando" id="medPMHora">21:00</div>
          <div class="estado-med" id="medPMEstado">Pendiente</div>
        </div>
      </div>
      <div class="nota">Los horarios y nombres se cambian en Ajustes. Para que la alarma suene con la app cerrada, usa <strong>Pasar todo al calendario</strong> en Ajustes.</div>
    </div>

    <div class="tarjeta">
      <h2>Agenda de hoy</h2>
      <div class="progreso-linea"><div id="progresoBarra" style="width:0%"></div></div>
      <div class="progreso-num" id="progresoNum">—</div>
      <div id="timelineHoy" style="margin-top:8px"></div>
    </div>
  </section>

  <!-- ============ PLANIFICAR ============ -->
  <section id="sec-plan">
    <div class="tarjeta">
      <h2>Rutina semanal <span class="pill">se repite</span></h2>
      <p class="nota" style="margin-top:0;margin-bottom:10px">Elige un día y agrega lo que se repite cada semana: clases, trabajo, gimnasio, estudio. Aparece solo en tu agenda.</p>
      <div class="dias-tabs" id="diasTabs">
        <button data-d="1">Lun</button><button data-d="2">Mar</button><button data-d="3">Mié</button>
        <button data-d="4">Jue</button><button data-d="5">Vie</button><button data-d="6">Sáb</button><button data-d="0">Dom</button>
      </div>
      <div id="listaRutina"></div>
      <div class="form-linea">
        <input type="time" id="rHora" value="09:00" aria-label="Hora de la actividad">
        <input type="text" id="rTexto" placeholder="Ej: gimnasio, clase de inglés, turno…" maxlength="80">
        <button class="btn chico" id="btnAgregarRutina">Agregar</button>
      </div>
      <div class="form-linea">
        <span style="font-size:13px;color:var(--gris)">Copiar este día a:</span>
        <select id="selCopiar" aria-label="Día de destino">
          <option value="1">lunes</option><option value="2">martes</option><option value="3">miércoles</option>
          <option value="4">jueves</option><option value="5">viernes</option><option value="6">sábado</option><option value="0">domingo</option>
        </select>
        <button class="btn fantasma chico" id="btnCopiarDia">Copiar</button>
        <span class="ok-msg" id="okCopiar">Copiado ✓</span>
      </div>
    </div>

    <div class="tarjeta">
      <h2>Eventos puntuales <span class="pill">una sola vez</span></h2>
      <p class="nota" style="margin-top:0;margin-bottom:6px">Con fecha propia: hora al médico, cumpleaños, una entrega, un trámite.</p>
      <div id="listaEventos"></div>
      <div class="form-linea">
        <input type="date" id="eFecha" aria-label="Fecha del evento">
        <input type="time" id="eHora" aria-label="Hora del evento (opcional)">
      </div>
      <div class="form-linea">
        <input type="text" id="eTexto" placeholder="Qué y dónde…" maxlength="100">
        <button class="btn chico" id="btnAgregarEvento">Agregar</button>
      </div>
    </div>

    <div class="tarjeta" id="tarjetaVencidos" style="display:none">
      <h2>Sin marcar <span class="pill">ya pasaron</span></h2>
      <div id="listaVencidos"></div>
    </div>

    <div class="tarjeta" id="tarjetaOmitidos" style="display:none">
      <h2>Días omitidos</h2>
      <div id="listaOmitidos"></div>
    </div>
  </section>

  <!-- ============ HISTORIAL ============ -->
  <section id="sec-historial">
    <div class="racha-caja">
      <div class="tarjeta" id="cajaRacha"><div class="racha-num" id="rachaMeds">0</div><div class="racha-lbl">Días seguidos con los medicamentos al día</div></div>
      <div class="tarjeta"><div class="racha-num" id="promActividades">—</div><div class="racha-lbl">Cumplimiento últimos 7 días</div></div>
    </div>
    <div class="tarjeta">
      <h2>Últimos 14 días</h2>
      <p class="nota" style="margin-top:0;margin-bottom:6px">Cada día guarda su propio plan: editar la rutina hoy no cambia el pasado. Un día sin registro aparece como “—”.</p>
      <div id="listaHistorial"></div>
    </div>
  </section>

  <!-- ============ AJUSTES ============ -->
  <section id="sec-ajustes">
    <div class="aviso" id="avisoNotif" style="display:none">
      <span>🔔</span><span style="flex:1">Activa las notificaciones para recibir los avisos.</span>
      <button class="btn chico" id="btnNotif">Activar</button>
    </div>
    <div class="aviso" id="avisoRespaldo" style="display:none">
      <span>💾</span><span style="flex:1">Han pasado más de dos semanas desde tu último respaldo.</span>
      <button class="btn chico" id="btnRespaldoAviso">Descargar</button>
    </div>
    <div class="aviso gris" id="avisoAlmac" style="display:none">
      <span>⚠️</span><span style="flex:1" id="avisoAlmacTxt"></span>
    </div>

    <div class="tarjeta">
